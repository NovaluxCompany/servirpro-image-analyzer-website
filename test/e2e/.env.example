# Copia este archivo como ".env" (en la misma carpeta) y complétalo con
# credenciales de un ambiente de pruebas/staging. NUNCA uses credenciales
# de producción aquí. El archivo ".env" está en .gitignore.

BASE_URL=http://localhost:4200

ADMIN_EMAIL=demo@gmail.com
ADMIN_PASSWORD=Demo.2026

ASESOR_EMAIL=asesor@gmail.com
ASESOR_PASSWORD=123Asesor

PAGO_EMAIL=pago@gmail.com
PAGO_PASSWORD=123Pagos

CARGA_AFILIADOS_EMAIL=cargaAfiliados@gmail.com
CARGA_AFILIADOS_PASSWORD=123cargaAfiliados

# Prefijo (no nombre exacto) usado por el spec de Desactivar Afiliados para
# encontrar CUALQUIER afiliado de prueba elegible y desactivar solo ese uno.
TEST_DEACTIVATE_AFFILIATE_NAME=Prueba-

# Documento(s) de 1-2 afiliados "No Ordinario" YA EXISTENTES en el ambiente
# de pruebas, usados por el spec de Actualizar Empresa (separados por coma).
# No se crean automáticamente: ese módulo solo actualiza afiliados existentes
# vía archivo .xlsx, así que se necesitan documentos reales de prueba.
UPDATE_COMPANY_TEST_DOCUMENTS=1000000001,1000000002
UPDATE_COMPANY_TARGET_NAME=EMPRESA DE PRUEBAS QA
